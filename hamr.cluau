// Hearth's suite for hamr (github.com/Aosiee/hamr): `hamr run` here.
//
// Each configuration builds in its own build-hamr-<name> directory and runs
// the suite binaries' cases side by side. The fast tier is GCC release and
// debug and a Clang release; the nightly tier adds the address,
// undefined-behaviour and thread sanitizers and a build without zones and
// the GPU developer tools. The GPU suite runs on whatever Vulkan device the
// machine has (lavapipe in CI).
//
//     hamr run                       the fast tier
//     hamr run --tier nightly        every configuration
//     hamr run --set hamrDir=<dir>   a local hamr checkout instead of fetching
//     hamr run --set glfwDir=<dir> --set vulkanHeadersDir=<dir>   the same for GLFW and Vulkan-Headers
//     (and volkDir, vmaDir, loomDir, blake3Dir, spirvCrossDir for the GPU layer's)
//
// GLFW builds with its null platform only (the platform cases run on it), as
// in CI: no display or window-system libraries needed.

const hamr = require("@hamr")
type Context = hamr.Context

const suite = hamr.suite("hearth", { budgets = { fast = 120, nightly = 480 } })
const gcc = suite:var("gcc", "g++")
const clang = suite:var("clang", "clang++")
const hamrDir = suite:var("hamrDir", "")
const glfwDir = suite:var("glfwDir", "")
const vulkanHeadersDir = suite:var("vulkanHeadersDir", "")
// The GPU layer's libraries, the same way: volkDir, vmaDir, loomDir,
// blake3Dir, spirvCrossDir.
const libraryDirs: { { name: string, option: string } } = {
	{ name = "volkDir", option = "HEARTH_VOLK_DIR" },
	{ name = "vmaDir", option = "HEARTH_VMA_DIR" },
	{ name = "loomDir", option = "HEARTH_LOOM_DIR" },
	{ name = "blake3Dir", option = "HEARTH_BLAKE3_DIR" },
	{ name = "spirvCrossDir", option = "HEARTH_SPIRV_CROSS_DIR" },
}
const libraryFlags: { string } = {}
for (_, library in libraryDirs) {
	const dir = suite:var(library.name, "")
	if (dir != "") {
		table.insert(libraryFlags, `-D{library.option}={dir}`)
	}
}

type Config = { name: string, cxx: string, type: string, flags: { string }, tier: string, sanitizer: string? }

const configs: { Config } = {
	{ name = "gcc-release", cxx = gcc, type = "Release", flags = {}, tier = "fast" },
	{ name = "gcc-debug", cxx = gcc, type = "Debug", flags = {}, tier = "fast" },
	{ name = "clang-release", cxx = clang, type = "Release", flags = {}, tier = "fast" },
	{ name = "no-zones", cxx = gcc, type = "Debug", flags = { "-DHEARTH_NO_ZONES=ON", "-DHEARTH_GPU_DEBUG=OFF" }, tier = "nightly" },
	{ name = "asan", cxx = gcc, type = "RelWithDebInfo", flags = { "-DHEARTH_SANITIZE=address" }, tier = "nightly", sanitizer = "address" },
	{ name = "ubsan", cxx = gcc, type = "RelWithDebInfo", flags = { "-DHEARTH_SANITIZE=undefined" }, tier = "nightly", sanitizer = "undefined" },
	{ name = "tsan", cxx = gcc, type = "RelWithDebInfo", flags = { "-DHEARTH_SANITIZE=thread" }, tier = "nightly", sanitizer = "thread" },
}

const kPaths = { "include/**", "src/**", "tests/**", "CMakeLists.txt" }

for (_, c in configs) {
	const dir = `build-hamr-{c.name}`
	suite:step(`build:{c.name}`, {
		tier = c.tier,
		doc = `Configures and builds Hearth and its suite ({c.cxx}, {c.type}).`,
		resources = { exclusive = true },
		timeout = 900,
		budget = if (c.sanitizer != nil) 60 else 30,
		paths = kPaths,
		run = function(ctx: Context) {
			const configure = { "cmake", "-S", ".", "-B", dir, "-G", "Ninja", `-DCMAKE_BUILD_TYPE={c.type}`, `-DCMAKE_CXX_COMPILER={c.cxx}`, "-DHEARTH_NULL_PLATFORM_ONLY=ON" }
			if (hamrDir != "") {
				table.insert(configure, `-DHEARTH_HAMR_DIR={hamrDir}`)
			}
			if (glfwDir != "") {
				table.insert(configure, `-DHEARTH_GLFW_DIR={glfwDir}`)
			}
			if (vulkanHeadersDir != "") {
				table.insert(configure, `-DHEARTH_VULKAN_HEADERS_DIR={vulkanHeadersDir}`)
			}
			for (_, flag in libraryFlags) {
				table.insert(configure, flag)
			}
			for (_, flag in c.flags) {
				table.insert(configure, flag)
			}
			ctx:run(configure)
			ctx:run({ "cmake", "--build", dir, "-j", tostring(host.cores()) })
		},
	})
	// The GPU suite needs a Vulkan device; not under the sanitizers (the
	// driver is not built with them).
	const binaries = { "hearth_tests", "hearth_platform_tests", "hearth_default_host_tests", "hearth_rhi_tests" }
	if (c.sanitizer == nil) {
		table.insert(binaries, "hearth_rhi_gpu_tests")
	}
	for (_, binary in binaries) {
		hamr.tests(suite, `{binary}:{c.name}`, {
			doc = "The suite, each case in its own worker process.",
			tier = c.tier,
			needs = { `build:{c.name}` },
			binary = `{dir}/{binary}`,
			env = { UBSAN_OPTIONS = "halt_on_error=1:print_stacktrace=1" },
			resources = { tags = { c.name } },
			stepTimeout = 300,
			budget = if (c.sanitizer != nil) 30 else 10,
			paths = kPaths,
		})
	}
}
